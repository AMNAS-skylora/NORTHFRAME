# Server-only. Never prefix these keys with NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=northframe
ADMIN_EMAIL=admin@example.com
# Generate with: node scripts/create-admin-password.mjs
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Contact form notification to the owner. Set this to your receiving inbox.
CONTACT_TO_EMAIL=
# Recommended for Vercel / hosted apps: create a Resend API key and verify
# the domain used by CONTACT_FROM_EMAIL (e.g. notifications@yourdomain.com).
# If RESEND_API_KEY is present, HTTPS delivery is used instead of SMTP.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Optional Gmail SMTP fallback (when RESEND_API_KEY is empty).
# Requires a Google App Password; your normal Gmail password won't work.
# Current SMTP transport supports implicit TLS on port 465 only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
